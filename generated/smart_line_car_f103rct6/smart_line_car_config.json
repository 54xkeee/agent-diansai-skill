{
  "mcu": {
    "user_name": "STM32F103RCTx",
    "cpn": "STM32F103RCT6",
    "cubemx_name": "STM32F103R(C-D-E)Tx",
    "package": "LQFP64"
  },
  "project": {
    "name": "SmartLineCar_F103RCT6",
    "toolchain": "MDK-ARM V5.32",
    "stack": "0x800",
    "heap": "0x400"
  },
  "peripherals": [
    {
      "type": "pwm",
      "timer": "TIM1",
      "channels": [1, 2],
      "freq_hz": 20000,
      "labels": ["MOTOR_L_PWM", "MOTOR_R_PWM"]
    },
    {
      "type": "encoder",
      "timer": "TIM2",
      "label_a": "ENC_L_A",
      "label_b": "ENC_L_B"
    },
    {
      "type": "encoder",
      "timer": "TIM3",
      "label_a": "ENC_R_A",
      "label_b": "ENC_R_B"
    },
    {
      "type": "scheduler",
      "timer": "TIM4",
      "period_ms": 1
    },
    {
      "type": "adc",
      "channels": [8, 9, 10, 11, 12, 13, 14, 15],
      "dma": true
    },
    {
      "type": "i2c",
      "bus": "I2C1",
      "speed_hz": 100000,
      "labels": ["I2C1_SCL_IMU_OLED", "I2C1_SDA_IMU_OLED"]
    },
    {
      "type": "uart",
      "instance": "USART3",
      "baudrate": 115200,
      "labels": ["DEBUG_TX", "DEBUG_RX"]
    }
  ],
  "gpio": [
    {
      "pin": "PC6",
      "label": "AIN1",
      "direction": "output"
    },
    {
      "pin": "PC7",
      "label": "AIN2",
      "direction": "output"
    },
    {
      "pin": "PB14",
      "label": "BIN1",
      "direction": "output"
    },
    {
      "pin": "PB15",
      "label": "BIN2",
      "direction": "output"
    },
    {
      "pin": "PC10",
      "label": "TB6612_STBY",
      "direction": "output"
    },
    {
      "pin": "PB12",
      "label": "BUZZER",
      "direction": "output"
    },
    {
      "pin": "PB13",
      "label": "STATUS_LED",
      "direction": "output"
    },
    {
      "pin": "PC8",
      "label": "BUTTON_START",
      "direction": "input",
      "pull": "GPIO_PULLUP"
    },
    {
      "pin": "PC9",
      "label": "BUTTON_MODE",
      "direction": "input",
      "pull": "GPIO_PULLUP"
    }
  ],
  "assumptions": [
    "Hardware: STM32F103RCT6 LQFP64, TB6612FNG dual motor driver, two DC motors with AB encoders, 8-channel analog grayscale line sensor, MPU6050 and 0.96 OLED on I2C1, UART3 debug, buzzer, status LED, two buttons.",
    "PWM: TIM1 CH1/CH2 at 20kHz for left/right motor speed; USART1 is avoided because PA9 conflicts with TIM1_CH2.",
    "Direction GPIO: PC6/PC7 drive AIN1/AIN2, PB14/PB15 drive BIN1/BIN2, PC10 drives TB6612 STBY and must be set high in firmware.",
    "Encoders: TIM2 uses PA0/PA1 for left wheel, TIM3 uses PA6/PA7 for right wheel, encoder mode TI12.",
    "Line sensor: ADC1 channels IN8-IN15 use PB0/PB1/PC0-PC5 with DMA circular mode.",
    "Scheduler: TIM4 basic timer interrupt at 1ms, no physical channel pin.",
    "Clock: external 8MHz HSE, PLL x9, SYSCLK 72MHz; Keil MDK-ARM target."
  ]
}
